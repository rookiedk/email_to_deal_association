{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rookiedk/email_to_deal_association/schema/canonical.schema.json",
  "title": "Email-to-deal canonical CRM",
  "description": "Standardized records for accounts, contacts, deals, emails, associations, gold labels, and audit events.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z]+_[a-z0-9_]+$"
    },
    "emailAddress": {
      "type": "string",
      "format": "email"
    },
    "decision": {
      "type": "string",
      "enum": ["auto_associate", "needs_review", "unmatched"]
    },
    "associationSource": {
      "type": "string",
      "enum": ["predicted", "gold", "human_override"]
    },
    "dealType": {
      "type": "string",
      "enum": ["new_business", "renewal", "expansion"]
    },
    "contactRole": {
      "type": "string",
      "enum": ["champion", "economic_buyer", "evaluator", "legal", "other"]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "domain": { "type": "string", "description": "Registrable domain, lowercase, no protocol." },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "industry": { "type": ["string", "null"] }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "account_id", "email", "full_name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "account_id": { "$ref": "#/$defs/id" },
        "email": { "$ref": "#/$defs/emailAddress" },
        "email_aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/emailAddress" },
          "default": []
        },
        "full_name": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "source": {
          "type": "string",
          "enum": ["crm", "clay_enrich"],
          "default": "crm"
        }
      }
    },
    "deal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "account_id", "name", "amount", "currency", "stage", "is_closed", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "account_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "stage": { "type": "string" },
        "is_closed": { "type": "boolean" },
        "close_date": { "type": ["string", "null"], "format": "date" },
        "type": { "$ref": "#/$defs/dealType" }
      }
    },
    "dealContactRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deal_id", "contact_id", "role", "is_primary"],
      "properties": {
        "deal_id": { "$ref": "#/$defs/id" },
        "contact_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/contactRole" },
        "is_primary": { "type": "boolean" }
      }
    },
    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "thread_id", "sent_at", "from_email", "to", "subject", "body_text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "thread_id": { "type": "string" },
        "internet_message_id": { "type": ["string", "null"] },
        "sent_at": { "type": "string", "format": "date-time" },
        "from_email": { "$ref": "#/$defs/emailAddress" },
        "from_name": { "type": ["string", "null"] },
        "to": {
          "type": "array",
          "items": { "$ref": "#/$defs/emailAddress" },
          "minItems": 1
        },
        "cc": {
          "type": "array",
          "items": { "$ref": "#/$defs/emailAddress" },
          "default": []
        },
        "subject": { "type": "string" },
        "body_text": { "type": "string" }
      }
    },
    "emailAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email_id", "confidence", "decision", "source"],
      "properties": {
        "email_id": { "$ref": "#/$defs/id" },
        "deal_id": { "type": ["string", "null"] },
        "account_id": { "type": ["string", "null"] },
        "contact_id": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "decision": { "$ref": "#/$defs/decision" },
        "source": { "$ref": "#/$defs/associationSource" }
      }
    },
    "goldLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email_id"],
      "properties": {
        "email_id": { "$ref": "#/$defs/id" },
        "contact_id": { "type": ["string", "null"] },
        "account_id": { "type": ["string", "null"] },
        "deal_id": {
          "type": ["string", "null"],
          "description": "Null means a true negative: no deal should be filed."
        }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email_id", "created_at", "decision", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "email_id": { "$ref": "#/$defs/id" },
        "created_at": { "type": "string", "format": "date-time" },
        "clay_run_id": { "type": ["string", "null"] },
        "resolved_contact_id": { "type": ["string", "null"] },
        "resolved_account_id": { "type": ["string", "null"] },
        "candidate_deal_ids": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "chosen_deal_id": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "decision": { "$ref": "#/$defs/decision" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["accounts", "contacts", "deals", "deal_contact_roles", "emails", "gold_labels"],
  "properties": {
    "accounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/account" }
    },
    "contacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contact" }
    },
    "deals": {
      "type": "array",
      "items": { "$ref": "#/$defs/deal" }
    },
    "deal_contact_roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/dealContactRole" }
    },
    "emails": {
      "type": "array",
      "items": { "$ref": "#/$defs/email" }
    },
    "gold_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/goldLabel" }
    },
    "email_associations": {
      "type": "array",
      "items": { "$ref": "#/$defs/emailAssociation" },
      "default": []
    },
    "audit_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/auditEvent" },
      "default": []
    }
  }
}
